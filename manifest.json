{
  "manifest_version": 3,
  "name": "StudyLens",
  "short_name": "StudyLens",
  "version": "2.0.0",
  "description": "See what matters. Learn what counts. Turn a webpage or your own files into summaries, reviewers, quizzes, flashcards, and highlights.",
  "minimum_chrome_version": "116",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "StudyLens - See what matters. Learn what counts.",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open StudyLens"
    }
  },

  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },

  "options_page": "options/options.html",

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "contextMenus"
  ],

  "host_permissions": [
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*"
  ],

  "optional_host_permissions": [
    "<all_urls>"
  ]
}
